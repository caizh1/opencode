{
  "schemaVersion": 2,
  "version": "2026-06-28.w44",
  "name": "chipmate-documents-helper-scripts",
  "description": "Codex documents helper script catalog mapped to ChipMate's offline local Word tools and parity backlog.",
  "executionPolicy": {
    "directExecution": false,
    "networkPolicy": "none",
    "reason": "This documents helper catalog maps Codex scripts to native ChipMate tools and backlog items. Direct execution is available only for manifest v2 helper entries that opt in through execution.directExecution and the safe script execution boundary.",
    "readTool": "chipmate_read_skill_resource",
    "executionTool": "chipmate_run_skill_script"
  },
  "sources": {
    "codexManifest": "C-Manifest",
    "codexScripts": "C-Scripts",
    "chipmateTools": "CM-Tools",
    "chipmateSkill": "CM-Skill"
  },
  "helpers": [
    {
      "name": "helper_manifest_report",
      "category": "diagnostics",
      "chipmateEquivalent": ["chipmate_run_skill_script"],
      "status": "executable",
      "description": "Read-only diagnostic helper that summarizes this manifest and writes a bounded JSON artifact.",
      "execution": {
        "directExecution": true,
        "runtime": "node",
        "entrypoint": "scripts/helper_manifest_report.mjs",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "outputArtifacts": [
          {
            "name": "helper-manifest-report",
            "kind": "diagnostic-json",
            "contentType": "application/json",
            "path": "helper-manifest-report.json",
            "required": true,
            "description": "Documents helper catalog status report."
          }
        ],
        "timeoutMs": 5000,
        "maxOutputBytes": 8192,
        "allowedExtensions": [".json"],
        "networkPolicy": "none"
      }
    },
    {
      "name": "word_runtime_field_refresh_report",
      "category": "diagnostics",
      "chipmateEquivalent": ["chipmate_run_skill_script"],
      "status": "executable",
      "description": "Read-only legacy diagnostic helper. Native TOC/PAGE/NUMPAGES refresh is unavailable in the remote-render-only VSIX build; prefer static TOC/page text or manual Word field update.",
      "execution": {
        "directExecution": true,
        "runtime": "node",
        "entrypoint": "scripts/word_runtime_field_refresh_report.mjs",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "documentPath": {
              "type": "string",
              "pathKind": "workspace",
              "allowedExtensions": [".docx"],
              "maxLength": 512
            }
          }
        },
        "outputArtifacts": [
          {
            "name": "word-runtime-field-refresh-report",
            "kind": "diagnostic-json",
            "contentType": "application/json",
            "path": "word-runtime-field-refresh-report.json",
            "required": true,
            "description": "Word native field refresh limitation report."
          }
        ],
        "timeoutMs": 5000,
        "maxOutputBytes": 8192,
        "allowedExtensions": [".docx", ".json"],
        "networkPolicy": "none"
      }
    },
    {
      "codexScript": "a11y_audit.py",
